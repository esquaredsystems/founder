---
layout: null
permalink: /courses/courses.json
---
{%- comment -%}
  A video file is embedded as a player by default. List a video's exact
  filename here (comma-separated) to keep it a plain download link instead,
  the same way every other material already shows.
{%- endcomment -%}
{%- assign force_download = "" | split: "," -%}
[
{%- for c in site.data.teaching -%}
{%- assign cslug = c.course | slugify -%}
{%- assign prefix = cslug | prepend: "/courses/" | append: "/" -%}
{%- assign files = site.static_files | where_exp: "f", "f.path contains prefix" | sort: "path" -%}
{
"slug": {{ cslug | jsonify }},
"term": {{ c.term | jsonify }},
"course": {{ c.course | jsonify }},
"topics": {{ c.topics | default: "" | jsonify }},
"materials": [{%- for f in files -%}{"name": {{ f.basename | jsonify }}, "ext": {{ f.extname | remove: "." | jsonify }}, "path": {{ f.path | relative_url | jsonify }}, "kind": {% if f.extname == ".mp4" or f.extname == ".webm" or f.extname == ".mov" or f.extname == ".m4v" %}{% assign f_filename = f.basename | append: f.extname %}{% if force_download contains f_filename %}"file"{% else %}"video"{% endif %}{% else %}"file"{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
